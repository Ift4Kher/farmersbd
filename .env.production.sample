# ============================================================
# FarmersBD — Production Environment Configuration (.env)
# Rename or copy this file to ".env" inside public_html on cPanel
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME="FarmersBD"
APP_URL="https://yourdomain.com"
APP_ENV="production"
APP_DEBUG="false"
APP_TIMEZONE="Asia/Dhaka"

# ── Database (Create in cPanel -> MySQL Databases) ───────────
# Note: cPanel prefixes database names and users with your cPanel username (e.g. yourcpanel_farmersbd)
DB_HOST="localhost"
DB_PORT="3306"
DB_DATABASE="yourcpanel_farmersbd"
DB_USERNAME="yourcpanel_dbuser"
DB_PASSWORD="YourStrongDatabasePassword123!@"
DB_CHARSET="utf8mb4"

# ── Session ─────────────────────────────────────────────────
SESSION_NAME="farmersbd_session"
SESSION_LIFETIME=7200

# ── SSLCOMMERZ Payment Gateway ──────────────────────────────
# For live deployment, insert your approved Live Store ID & Password
SSLCOMMERZ_STORE_ID="your_live_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_live_store_password"
SSLCOMMERZ_SANDBOX="false"

# ── Google Gemini AI Service ─────────────────────────────────
AI_API_URL="https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent"
AI_API_KEY="your_gemini_api_key_here"
AI_API_TIMEOUT=45

AI_MAX_IMAGE_SIZE=52428800
AI_MAX_REQUESTS_PER_DAY=20

# ── File Uploads ─────────────────────────────────────────────
UPLOAD_MAX_SIZE=52428800
ALLOWED_IMAGE_TYPES="jpg,jpeg,png,webp"

# ── Security ─────────────────────────────────────────────────
CSRF_TOKEN_NAME="_csrf_token"
SECRET_KEY="f8a1e2d3c4b5a67890123456789abcdef0123456789abcdef0123456789abcdef"
