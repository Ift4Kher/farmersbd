# ============================================================
# FarmersBD Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Application
APP_NAME="FarmersBD"
APP_URL="https://yourdomain.com"
APP_ENV="production"          # development | production
APP_DEBUG="false"             # true | false (always false in production)
APP_TIMEZONE="Asia/Dhaka"

# Database
DB_HOST="localhost"
DB_PORT="3306"
DB_DATABASE="your_cpanel_db"
DB_USERNAME="your_cpanel_user"
DB_PASSWORD="your_db_password"
DB_CHARSET="utf8mb4"

# Session
SESSION_NAME="farmersbd_session"
SESSION_LIFETIME=7200       # seconds (2 hours)

# SSLCOMMERZ Payment Gateway
SSLCOMMERZ_STORE_ID="your_live_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_live_store_password"
SSLCOMMERZ_SANDBOX="false"  # set to false for real live payments

# Google Gemini AI Service
AI_API_URL="https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent"
AI_API_KEY="your_gemini_api_key_here"
AI_API_TIMEOUT=45           # seconds
AI_MAX_IMAGE_SIZE=52428800  # 50MB in bytes
AI_MAX_REQUESTS_PER_DAY=20

# File Uploads
UPLOAD_MAX_SIZE=52428800    # 50MB in bytes
ALLOWED_IMAGE_TYPES="jpg,jpeg,png,webp"

# Security
CSRF_TOKEN_NAME="_csrf_token"
SECRET_KEY="generate-a-random-64-character-secret-key-here"

